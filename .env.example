# Copy this file to .env and fill in your key. .env is gitignored.

# Required for the suggestion engine (Training Mode and live calls).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for live-call transcription (not needed for Training Mode).
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional — enables live REISift property sync (see the README's Property
# Context section). Create a URL at https://webhook.site, paste it here AND
# into REISift's own Settings -> Integrations -> Webhooks. Leave blank to
# disable the sync (paste-and-parse still works either way).
REISIFT_WEBHOOK_SITE_URL=

# Optional — only needed if the webhook.site URL above belongs to a
# logged-in webhook.site account rather than an anonymous one. Find it in
# webhook.site's account settings.
WEBHOOK_SITE_API_KEY=

# Optional — pushes the other direction: call dispositions, new phone
# numbers, and new contacts FROM this app back INTO REISift, via Zapier
# (see the README's "Pushing dispositions and new contacts back to REISift"
# section for how to build the three Zaps). Each is independent — leave any
# of them blank to disable just that push. All three only ever fire for a
# property/contact REISift already knows about from a prior inbound sync.
REISIFT_ZAPIER_STATUS_WEBHOOK_URL=
REISIFT_ZAPIER_NEW_PHONE_WEBHOOK_URL=
REISIFT_ZAPIER_NEW_CONTACT_WEBHOOK_URL=
