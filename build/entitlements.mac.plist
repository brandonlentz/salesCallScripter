<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements required for notarization once this app is
  signed with a real Developer ID (see package.json's build.mac config and
  .github/workflows/release.yml). Not used for local unsigned dev builds —
  electron-builder only applies these when hardenedRuntime + a real
  identity are active.

  This app is NOT sandboxed, but the hardened runtime still gates the
  microphone: without com.apple.security.device.audio-input, a signed
  hardened build never shows the mic prompt and getUserMedia hands back a
  silent stream — the 'rep' channel records nothing while the 'prospect'
  channel (the separate audiotap helper) works fine.

  The other four are Electron's own standard hardened-runtime requirements —
  without them, Electron's V8 JIT and any unsigned/mismatched-signature
  native dependencies (node-gyp addons, etc.) fail at runtime under a
  hardened, notarized build even though they work fine unsigned.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
