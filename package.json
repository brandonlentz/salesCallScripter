{
  "name": "sales-call-scripter",
  "version": "0.1.3",
  "description": "AI-powered sales teleprompter built on the NEPQ framework",
  "main": "./out/main/index.js",
  "author": "Brandon Lentz",
  "private": true,
  "type": "module",
  "repository": "github:brandonlentz/salesCallScripter",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:audiotap": "native/audiotap/build.sh",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^2.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.salescallscripter.app",
    "productName": "Sales Call Scripter",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "native/audiotap/build/audiotap",
        "to": "audiotap"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "brandonlentz",
      "repo": "salesCallScripter",
      "releaseType": "release"
    }
  }
}
